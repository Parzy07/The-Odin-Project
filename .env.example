# IBKR TWS/Gateway host (use 127.0.0.1 if TWS runs on same machine as this app)
IB_HOST=192.168.1.207
IB_PORT=7497
IB_CLIENT_ID=1
IB_READONLY=true
DEMO_MODE=true

# Server binding — 0.0.0.0 allows LAN access (e.g. http://192.168.1.207:8000)
BIND_HOST=0.0.0.0
BIND_PORT=8000

# CORS: use * for LAN/dev, or list origins comma-separated
CORS_ORIGINS=*
